# ==============================================================================
# VKU STUDY ROOM BOOKING - BIẾN MÔI TRƯỜNG SUPABASE
# ==============================================================================
# Hướng dẫn lấy key từ trang quản trị Supabase:
# 1. Truy cập https://supabase.com -> Đăng nhập -> Tạo Project mới
# 2. Vào mục Project Settings (icon bánh răng) -> Chọn "API"
# 3. Copy "Project URL" dán vào EXPO_PUBLIC_SUPABASE_URL
# 4. Copy "anon public key" dán vào EXPO_PUBLIC_SUPABASE_ANON_KEY
# 5. Lưu file này thành tên .env trong thư mục gốc dự án

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
